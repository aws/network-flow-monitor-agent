#!/usr/bin/env python3

import argparse
import glob
import json
import math
import os
import re
import sh
import statistics

from sh import CommandNotFound

# This script generates PNG images from the data series across all TPS ranges
# of a set of load tests, plus charts.json and an interactive index.html.

parser = argparse.ArgumentParser("generate-graph-set")
parser.add_argument('--tps-report-dir', required=True)
parser.add_argument('--test-run-id', required=True)
parser.add_argument('--instance-types', help='A list of instance types, comma separated', required=True)
parser.add_argument('--tps-values', help='The TPS test values, comma separated', required=True)
parser.add_argument('--output-dir', help='Image output directory', required=True)
parser.add_argument('--baseline-dir', help='Directory of baseline tps reports, drawn dashed', required=False)
args = parser.parse_args()

inst_types = args.instance_types.split(',')
tps_values = args.tps_values.split(',')

def jq_value(filepath, jquery):
    try:
        return float(sh.jq('--monochrome-output', jquery, filepath).strip())
    except (sh.ErrorReturnCode, ValueError):
        return math.nan

def get_y_vals(inst_type, jquery):
    y_vals = []
    for tps_val in tps_values:
        file_prefix = str.format("results-{}", args.test_run_id)
        filename = '_'.join([file_prefix, inst_type, tps_val, 'tps-report.json'])
        filepath = os.path.join(args.tps_report_dir, filename)
        if not os.path.exists(filepath):
            print(f"Missing {filepath}")
        y_vals.append(jq_value(filepath, jquery))
    return y_vals

def get_baseline_vals(inst_type, jquery):
    y_vals = []
    for tps_val in tps_values:
        matches = glob.glob(os.path.join(args.baseline_dir, f'*_{inst_type}_{tps_val}_tps-report.json'))
        y_vals.append(jq_value(matches[0], jquery) if matches else math.nan)
    return y_vals

def fmt(vals):
    return ','.join('nan' if math.isnan(v) else "{:.3f}".format(v) for v in vals)

def change_flag(series):
    # Flags a chart when the median per-point change vs baseline exceeds 10%; points that
    # moved less than 5% of the chart's y-max count as unchanged.
    pts = [(p, b) for s in series for p, b in zip(s['pr'], s['base'] or [])
           if math.isfinite(p) and math.isfinite(b)]
    if not pts:
        return ''
    floor = 0.05 * max(max(p, b) for p, b in pts)
    changes = [0 if abs(p - b) <= floor else (p - b) / b * 100 for p, b in pts if b != 0]
    if not changes:
        return ''
    median = statistics.median(changes)
    return '🔻' if median > 10 else '▲' if median < -10 else ''

charts = []
category = ''
graph_position = 0
def produce_graph(title, jquery, y_label='', y_suffix=''):
    global graph_position
    graph_position += 1

    line_args = []
    series = []
    for inst_type in inst_types:
        y_vals = get_y_vals(inst_type, jquery)
        base_vals = get_baseline_vals(inst_type, jquery) if args.baseline_dir else None
        line_args.append(['--line', inst_type + ':' + fmt(y_vals)])
        if base_vals and any(math.isfinite(v) for v in base_vals):
            line_args.append(['--baseline-line', inst_type + ':' + fmt(base_vals)])
        series.append({'name': inst_type, 'pr': y_vals, 'base': base_vals})

    if not any(math.isfinite(v) for s in series for v in s['pr']):
        print('Skipping', title, '(no data)')
        return

    print('Generating', title)
    try:
        cmd = getattr(sh, 'generate-graph')
    except CommandNotFound:
        # In case we are running this from the package root.
        cmd = getattr(sh, 'bin/generate-graph')

    prefix = "{:02d}-".format(graph_position)
    cmd(
        '--title', title,
        '--x-values', args.tps_values,
        '--x-axis-label', 'TPS',
        '--y-axis-label', y_label,
        '--y-axis-suffix', y_suffix,
        '--output-dir', args.output_dir,
        '--image-name-prefix', prefix,
        *[a for pair in line_args for a in pair],
    )
    image_name = prefix + re.sub(r'[^\w\-]', '', title.replace(' ', '-').lower()) + '.png'
    charts.append({'title': title, 'category': category, 'file': image_name,
                   'flag': change_flag(series), 'y_label': y_label, 'y_suffix': y_suffix,
                   'series': [{k: ([None if math.isnan(v) else v for v in s[k]] if s[k] else None)
                               if k != 'name' else s[k] for k in s} for s in series]})

run_id =  args.test_run_id.upper()

# Produce each graph from a given jquery.

category = 'Agent CPU'
for pct in ['max', 'p95', 'p90', 'avg']:
    produce_graph(
        title=str.format('Agent CPU Utilization {} ({})', pct.replace('max', 'p100'), run_id),
        jquery=f'(.tps_report.sonar_bpf_program.cpu_util_pct.{pct} + .tps_report.sonar_agent_process.cpu_util_pct.{pct})',
        y_label='',
        y_suffix='%',
    )

produce_graph(
    title=str.format('Agent Single-CPU Utilization p100 ({})', run_id),
    jquery='(.tps_report.sonar_bpf_program.cpu_util_pct.max + .tps_report.sonar_agent_process.cpu_util_pct.max) * .tps_report.cpu_cores',
    y_label='',
    y_suffix='%',
)

produce_graph(
    title=str.format('Agent User-space CPU Utilization p100 ({})', run_id),
    jquery='(.tps_report.sonar_agent_process.cpu_util_pct.max)',
    y_label='',
    y_suffix='%',
)

