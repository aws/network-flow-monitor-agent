with open(os.path.join(args.output_dir, 'charts.json'), 'w') as f:
    json.dump(charts, f)
with open(os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'perf-report.html')) as f:
    template = f.read()
with open(os.path.join(args.output_dir, 'index.html'), 'w') as f:
    f.write(template.replace('__RUN_ID__', run_id).replace('__TPS__', json.dumps(list(map(int, tps_values))))
            .replace('__CHARTS__', json.dumps(charts).replace('</', '<\\/')))

print('Done!')
